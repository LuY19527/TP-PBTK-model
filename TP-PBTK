# =============================================================================
# TP-PBTK Model for Per- and Polyfluoroalkyl Substances (PFAS) in Zebrafish
# =============================================================================
# Model Structure: Physiologically-Based Toxicokinetic (PBTK) model
# Species:         Zebrafish (Danio rerio)
# Chemicals:       PFOS, PFHxS, PFOA, PFBS (n = 4 compounds, simulated simultaneously)
# Exposure route:  Aqueous (waterborne) gill uptake
# Elimination:     Gill excretion, urinary excretion, fecal excretion
# R version: 4.4.2
# =============================================================================
 
library(deSolve)     # ODE solver (lsodes method used for stiff systems)
library(openxlsx)    # Excel export
library(minpack.lm)  # Nonlinear least squares fitting (nlsLM)
 
# =============================================================================
# HELPER: Arrhenius Temperature Correction Function
# =============================================================================
# Adjusts rate constants for water temperature relative to reference temperature
# KT(T, TR, TA) = exp(TA/TR - TA/T)
#   T  = actual water temperature (Kelvin)
#   TR = reference temperature (Kelvin)
#   TA = Arrhenius temperature constant (K), species/process-specific
# Source: Erickson & McKim (1990)
KT <- function(T, TR, TA) { exp((TA / TR) - (TA / T)) }
# =============================================================================
# SECTION I: PBTK ODE MODEL FUNCTION
# =============================================================================
# Compartments (amounts in microg):
#   A_blood   = blood (central compartment, includes plasma + red blood cells)
#   A_liv     = liver
#   A_GB      = gallbladder (bile accumulation before fecal excretion)
#   A_gon     = gonads
#   A_fat     = adipose tissue
#   A_git     = gastrointestinal tract
#   A_brain   = brain
#   A_kidney  = kidney cortex/medulla (post-reabsorption)
#   A_fil     = glomerular filtrate (pre-reabsorption, en route to urine)
#   A_skin    = skin
#   A_rp      = richly perfused tissues (e.g., heart, spleen)
#   A_pp      = poorly perfused tissues (e.g., muscle, bone)
#   A_water   = chemical mass remaining in exposure water
#
# Cumulative mass trackers:
#   A_absorb_gill = total absorbed via gills (uptake integral)
#   A_excr_gill   = total excreted back to water via gills
#   A_urine       = total excreted in urine
#   A_feces       = total excreted in feces (via bile)
#   A_excr_water  = sum of all elimination routes to water/outside
## =============================================================================

ZF.model.c <- function(t, initial_v, phys_exp_parms, chem_parms) {
  with(as.list(phys_exp_parms), {
 
    # ------------------------------------------------------------------
    # 1. Unpack state vector y into named compartment amounts
    # ------------------------------------------------------------------
    y <- unname(initial_v)
V_urine = y[1]   # cumulative urine volume (mL) — scalar

    # Each compartment block occupies n consecutive positions in y
    k = 0
    A_absorb_gill = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # absorbed via gill
    A_excr_gill   = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # excreted via gill
    A_urine       = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # urinary excretion
    A_feces       = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # fecal excretion (via bile)
    A_excr_water  = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # total excretion to water
    A_GB          = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # gallbladder
    A_blood       = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # blood
    A_liv         = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # liver
    A_gon         = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # gonads
    A_fat         = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # adipose
    A_git         = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # GI tract
    A_brain       = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # brain
    A_kidney      = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # kidney
    A_fil         = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # glomerular filtrate
    A_skin        = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # skin
    A_rp          = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # richly perfused
    A_pp          = y[(2+n*k):((2+n-1)+n*k)]; k=k+1  # poorly perfused
    A_water       = y[(2+n*k):((2+n-1)+n*k)]          # exposure water
 
    # ------------------------------------------------------------------
    # 2. Unpack chemical parameters from named list (robust by-name access)
    # ------------------------------------------------------------------
    i                 = chem_parms$i              # ionization flag: 1=acid, 0=neutral
    pKa               = chem_parms$pKa            # acid dissociation constant (log units)
    logKow            = chem_parms$logKow         # octanol-water partition coeff (log units)
    MW                = chem_parms$MW             # molecular weight (g/mol)
    pKd               = chem_parms$pKd            # protein binding affinity (log Ka, M^-1)
    Plivb             = chem_parms$Plivb          # liver:blood partition coefficient
    Pgonb             = chem_parms$Pgonb          # gonad:blood partition coefficient
    Pbb               = chem_parms$Pbb            # brain:blood partition coefficient
    Prpb              = chem_parms$Prpb           # richly perfused:blood partition coeff
    Pppb              = chem_parms$Pppb           # poorly perfused:blood partition coeff
    Pgitb             = chem_parms$Pgitb          # GI tract:blood partition coefficient
    Pfatb             = chem_parms$Pfatb          # adipose:blood partition coefficient
    Pskinb            = chem_parms$Pskinb         # skin:blood partition coefficient
    Pkidb             = chem_parms$Pkidb          # kidney:blood partition coefficient
 
    # Transporter kinetic parameters
    Vmax_ntcp         = chem_parms$Vmax_ntcp         # ntcp max uptake rate (nmol/d/g^0.75)
    Km_ntcp           = chem_parms$Km_ntcp           # ntcp Michaelis constant (nmol/mL)
    Vmax_oatp2b1      = chem_parms$Vmax_oatp2b1      # oatp2b1 hepatic Vmax
    Km_oatp2b1        = chem_parms$Km_oatp2b1        # oatp2b1 hepatic Km
    CL_excrL_p_gp_BW  = chem_parms$CL_excrL_p_gp_BW # p-gp biliary/apical CL (mL/d/g^0.75)
    CL_excrL_mrp_BW   = chem_parms$CL_excrL_mrp_BW  # mrp2 biliary CL (mL/d/g^0.75)
    CL_excrG_osta_BW  = chem_parms$CL_excrG_osta_BW  # osta intestinal efflux CL (mL/d)
    Vmax_oatp2b1K     = chem_parms$Vmax_oatp2b1K     # oatp2b1 renal Vmax
    Km_oatp2b1K       = chem_parms$Km_oatp2b1K       # oatp2b1 renal Km
    CL_ReabK_oct_BW   = chem_parms$CL_ReabK_oct_BW   # oct renal reabsorption CL
    R_loss            = chem_parms$R_loss      # fraction of bile excreted as feces (vs reabsorbed)
    PL                = chem_parms$PL         # protein-bound amount in blood (updated iteratively)
    blood_bound       = chem_parms$blood_bound        # total protein-bound mass in blood (microg)
    WaterExposure     = chem_parms$WaterExposure      # nominal water concentration (microg/mL)
 
    # ------------------------------------------------------------------
    # 3. Tissue volumes (mL), allometrically scaled to body weight (g)
    #    V_x = sc_x * BW^0.75  (allometric scaling exponent 0.75)
    # ------------------------------------------------------------------
    V_blood  = sc_blood  * BW^0.75
    V_liv    = sc_liv    * BW^0.75
    V_GB     = sc_GB     * BW^0.75
    V_gon    = sc_gon    * BW^0.75
    V_fat    = sc_fat    * BW^0.75
    V_git    = sc_git    * BW^0.75
    V_brain  = sc_brain  * BW^0.75
    V_kidney = sc_kidney * BW^0.75
    V_fil    = sc_fil    * BW^0.75   # filtrate volume (glomerular ultrafiltrate)
    V_skin   = sc_skin   * BW^0.75
    V_rp     = sc_rp     * BW^0.75
    # Poorly perfused volume = remainder after accounting for all other compartments
    V_pp = BW - (V_blood+V_liv+V_gon+V_fat+V_git+V_brain+V_kidney+V_fil+V_skin+V_rp+V_GB)
    V_total  = V_blood+V_liv+V_GB+V_gon+V_fat+V_git+V_brain+V_kidney+V_fil+V_skin+V_rp+V_pp
 
    # ------------------------------------------------------------------
    # 4. Cardiac output and ventilation (mL/d), temperature-corrected
    # ------------------------------------------------------------------
    TC_k  = TC_c + 273.15   # Convert exposure temp (°C) to Kelvin
    # Fcard: cardiac output (mL/d) — Arrhenius-corrected, allometrically scaled
    # Reference: F_card_ref at TR_Fcard; scaling exponent -0.1 for body weight
    Fcard = (F_card_ref * KT(T=TC_k, TR=TR_Fcard, TA=TA) * (BW/Bw_Fcard_ref)^(-0.1)) * BW
 
    # Q_10: metabolic scaling factor for transporter activity relative to 37°C
    # Used to adjust transporter Vmax/CL at fish body temperature (TC_c)
    Q_10  = 2.5^((TC_c - 37) / 10)
 
    # ------------------------------------------------------------------
    # 5. Tissue blood flows (mL/d)
    #    F_x = fraction_x * Fcard
    # ------------------------------------------------------------------
    Fliv    = liv_frac    * Fcard
    Fgon    = gon_frac    * Fcard
    Fgit    = git_frac    * Fcard
    Ffat    = fat_frac    * Fcard
    Fbrain  = brain_frac  * Fcard
    Fkidney = kidney_frac * Fcard
    Ffil    = fil_frac    * Fcard   # flow to glomerular filtration
    Fskin   = skin_frac   * Fcard
    Frp     = rp_frac     * Fcard
    Fpp     = Fcard - (Fliv+Fgon+Fgit+Ffat+Fbrain+Fkidney+Fskin+Frp+Ffil)
 
    # ------------------------------------------------------------------
    # 6. Gill ventilation and waterborne uptake/excretion rate constants
    # ------------------------------------------------------------------
    # VO2: oxygen consumption rate (mL O2/d), temperature & BW corrected
    VO2    = (VO2_ref * KT(T=TC_k, TR=TR_VO2, TA=TA) * (BW/BW_VO2_ref)^(-0.1)) * BW
    # Co2w: dissolved O2 in water (mL/mL) at given temperature and saturation
    Co2w   = ((-0.24 * TC_c + 14.04) * Sat) / 1e3
    # y_water: normalized ventilation rate (mL water / mL blood / d^-1)
    # Used to derive gill uptake (kx) and depuration (kout) rate constants
y_water = VO2 / (OEE * Co2w) * (1 / (1000^0.25 * BW^0.75))

    # ------------------------------------------------------------------
    # 7. Competitive plasma protein binding (iterative solver)
    #    Accounts for multi-compound competition for binding sites (albumin)
    #    Method: quadratic binding equilibrium solved iteratively
    #    P_avail: total available binding protein concentration (mol/L) 
    # ------------------------------------------------------------------
    L0 = A_blood
    if (!all(L0 == 0)) {
      PL_old  = PL
      K       = 10.0^(-pKd)                          # Ka = dissociation constant (M^-1)
      toler   = 1e-4                                  # convergence tolerance
      maxiter = length(K) * 1000
      L0      = (L0 * 1e-6) / (MW * (V_blood * 1e-3)) # convert microg → mol/L
      PL_new  = rep(0, length(K))
      for (k in seq(0, maxiter)) {
        for (j in seq(1, length(K))) {
          # Quadratic solution: [PL] from conservation: [P][L] = K[PL]
          b = P_avail + PL_old[j] + L0[j] + K[j]
          c = (P_avail + PL_old[j]) * L0[j]
          PL_new[j] = (b - sqrt(b*b - 4*c)) / 2
          P_avail = P_avail + PL_old[j] - PL_new[j]  # update remaining free protein
        }
        tm = sum(abs((PL_old - PL_new) / (PL_new + 1e-20)))
        if (tm < toler) break
        PL_old = PL_new
      }
      PL = PL_new
    }
    # Convert bound fraction back to microg
    blood_bound = PL * MW * 1000 * V_blood
    # free[i] = fraction of compound i that is unbound in blood
    free        = rep(1, n)
    idx         = A_blood > 0
    free[idx]   = 1 - (blood_bound[idx] / A_blood[idx])
 
    # ------------------------------------------------------------------
    # 8. Free (unbound) concentrations driving passive diffusion
    # ------------------------------------------------------------------
    C_blood_free = (A_blood / V_blood) * free  # free blood conc (microg/mL)
    C_fil_free   = A_fil / V_fil               # filtrate conc (assumes fully free)

    # ------------------------------------------------------------------
    # 9. Transporter-mediated fluxes (competitive Michaelis-Menten)
    #    All transporters use competitive inhibition across n compounds
    #    alpha = sum(C_free[j] / Km[j]) for j ≠ i (competitive inhibition factor)
    #    Scaled by BW^0.75 (allometric) and Q_10 (temperature)
    # ------------------------------------------------------------------
    v_ntcp     = rep(0, n)   # ntcp: hepatic basolateral uptake flux (microg/d)
    v_oatp2b1  = rep(0, n)   # oatp2b1: hepatic basolateral uptake flux
    v_oatp2b1K = rep(0, n)   # oatp2b1: renal tubular reabsorption flux
 
    # Helper: compute competitive inhibition factor alpha for compound s
    get_alpha_mix <- function(s, C_free_vec, Km_vec) {
      if (length(C_free_vec) <= 1) return(0)
      idx2 = setdiff(seq_len(length(C_free_vec)), s)
      sum(C_free_vec[idx2] / Km_vec[idx2], na.rm = TRUE)
    }
 
    for (s in 1:n) {
      # ntcp (Na+/taurocholate co-transporting polypeptide) — hepatic uptake
      alpha_ntcp    = get_alpha_mix(s, C_blood_free, Km_ntcp)
      denom_ntcp    = Km_ntcp[s] * (1 + alpha_ntcp) + C_blood_free[s]
      v_ntcp[s]     = Vmax_ntcp[s] * nctp_REF * BW^0.75 * Q_10 *
                      C_blood_free[s] / denom_ntcp
 
      # oatp2b1 — hepatic organic anion transporting polypeptide uptake
      alpha_2b1     = get_alpha_mix(s, C_blood_free, Km_oatp2b1)
      denom_2b1     = Km_oatp2b1[s] * (1 + alpha_2b1) + C_blood_free[s]
      v_oatp2b1[s]  = Vmax_oatp2b1[s] * oatp2b1_REF * BW^0.75 * Q_10 *
                      C_blood_free[s] / denom_2b1
 
      # oatp2b1 — renal tubular reabsorption from filtrate
      alpha_2b1K    = get_alpha_mix(s, C_fil_free, Km_oatp2b1K)
      denom_2b1K    = Km_oatp2b1K[s] * (1 + alpha_2b1K) + C_fil_free[s]
      v_oatp2b1K[s] = Vmax_oatp2b1K[s] * oatp2b1_REF * BW^0.75 * Q_10 *
                      C_fil_free[s] / denom_2b1K
    }
 
    # Total hepatic transporter-mediated uptake from blood (microg/d)
    Ab_abL   = v_ntcp + v_oatp2b1
 
    # Total renal reabsorption from filtrate (microg/d)
    # = oatp2b1 saturable + oct linear component
    CL_ReabK = CL_ReabK_oct_BW * BW^0.75 * Q_10 * oct_REF   # oct clearance (mL/d)
    Re_abk   = v_oatp2b1K + CL_ReabK * C_fil_free
 
    # ------------------------------------------------------------------
    # 10. Biliary/apical efflux clearances in liver (microg/d per microg/mL)
    #     p-gp (ABCB1) and mrp2 (ABCC2) — apical/canalicular transporters
    #     Drive secretion of PFAS from hepatocyte into bile canaliculi → GB
    # ------------------------------------------------------------------
    CL_excrL = CL_excrL_p_gp_BW * BW^0.75 * Q_10 * p_gp_REF +
               CL_excrL_mrp_BW  * BW^0.75 * Q_10 * mrp_REF   # total hepatic efflux CL (mL/d)
 
    # osta： intestinal basolateral efflux (reabsorption of bile into portal blood)
    CL_excrG_osta = CL_excrG_osta_BW * Q_10 * osta_REF  # (mL/d)
 
    # ------------------------------------------------------------------
    # 11. Ionization and tissue partitioning
    #     dow: pH-corrected effective Kow at blood pH 7.4
    #     PBW: blood:water partition coefficient (Bertelsen et al. equation)
    # ------------------------------------------------------------------
    logKow_ion = logKow - delta_Kow            # ionized form Kow
    # fn_fish: neutral fraction at blood pH 7.4 (Henderson-Hasselbalch)
    fn_fish    = 1 / (1 + 10^(i * (7.4 - pKa)))
    # dow: distribution coefficient = weighted average of neutral + ionized Kow
    dow        = fn_fish * 10^logKow + (1 - fn_fish) * 10^logKow_ion
    # PBW: Bertelsen equation for blood:water partitioning
    PBW        = 0.008*0.3*dow + 0.007*2.0*dow^0.94 + 0.134*2.9*dow^0.63 + 0.851
 
    # y_blood: normalized blood-side exchange rate (parallel to y_water for gills)
    y_blood    = Fcard * PBW * (1 / (1000^0.25 * BW^0.75))
 
    # kx: overall gill uptake rate constant (mL water/d/mL blood equivalent)
    # kout: gill back-diffusion rate constant (excretion to water)
    kx       = ((BW/1000)^0.75) / (2.8e-3 + 68/dow + 1/y_water + 1/y_blood) * 1000
    kout     = (1 / (68*(dow-1) + 1)) * kx
 
    # F_bile: bile flow rate (mL/d), allometrically scaled
    F_bile   = 0.0024 * BW^0.75
    # dV_urine: urine production rate (mL/d)
    dV_urine = urine_rate * BW^0.75
 
    # ------------------------------------------------------------------
    # 12. Free tissue concentrations for passive diffusion driving forces
    #  C_x_free = (A_x / V_x / Pxb) * free  [microg/mL, unbound]
    # ------------------------------------------------------------------
    C_liv_free = ((A_liv/V_liv) / Plivb) * free   # free liver conc
    C_git_free = ((A_git/V_git) / Pgitb) * free   # free GI tract conc
    # ------------------------------------------------------------------
    # 13. Transporter-driven mass fluxes (microg/d)
    # ------------------------------------------------------------------
    # Hepatic biliary excretion: p-gp + mrp2 secrete from liver → gallbladder
    Flux_excr_Liv   = CL_excrL * C_liv_free   # apical efflux flux (microg/d)
    # Passive bile secretion: hepatocytes → bile canaliculi by bulk bile flow
    Flux_bile_Liv   = F_bile * C_liv_free      # biliary flux (microg/d)
    # Intestinal reabsorption: OSTα transports PFAS from GI lumen → portal blood
    Flux_reab_GIT   = CL_excrG_osta * C_git_free  # osta flux (microg/d)
    # ==================================================================
    # 14. ODE SYSTEM (mass balance equations, microg/d)
    # ==================================================================
    # --- Gill exchange ---
    # dA_absorb_gill: rate of PFAS absorption from water into blood via gills
    dA_absorb_gill = kx * (A_water / V_water)
    # dA_excr_gill: rate of PFAS back-diffusion from blood to water via gills
    dA_excr_gill   = kout * (A_blood * free / V_blood)
 
    # --- Urinary excretion ---
    # PFAS filtered at glomerulus (A_fil), not yet reabsorbed → lost in urine
    dA_urine       = dV_urine * (A_fil / V_fil)
 
    # --- Fecal excretion ---
    # Fraction R_loss of bile-delivered PFAS in GB is excreted as feces
    dA_feces       = R_loss * F_bile * (A_GB / V_GB)
 
    # --- Total excretion flux to water/environment ---
    dA_excr_water_flux = dA_excr_gill + dA_urine + dA_feces
 
    # --- Peripheral tissue ODEs (flow-limited, passive equilibrium) ---
    # General form: dA_x/dt = F_x * free * (C_blood_free - C_x_free)
    dA_skin  = free * Fskin  * (A_blood/V_blood - (A_skin/V_skin)/Pskinb)
    dA_rp    = free * Frp    * (A_blood/V_blood - (A_rp/V_rp)/Prpb)
    dA_pp    = free * Fpp    * (A_blood/V_blood - (A_pp/V_pp)/Pppb)
    dA_brain = free * Fbrain * (A_blood/V_blood - (A_brain/V_brain)/Pbb)
    dA_fat   = free * Ffat   * (A_blood/V_blood - (A_fat/V_fat)/Pfatb)
    dA_gon   = free * Fgon   * (A_blood/V_blood - (A_gon/V_gon)/Pgonb)
 
    # --- Blood compartment (central) mass balance ---
    # Inflow:  gill absorption
    # Outflow: gill excretion + distribution to all tissues + hepatic transporter uptake
    #          + filtration
    # Return:  venous return from all tissues (via respective partition coefficients)
    # Net oata: intestinal PFAS reabsorbed from GI lumen enters portal → blood
    dA_blood = dA_absorb_gill - dA_excr_gill -
      free * (A_blood/V_blood) * (Fliv+Ffat+Fskin+Fgon+Fgit+Fbrain+Fkidney+Frp+Fpp) +
      free * (Ffat    * ((A_fat/V_fat)/Pfatb)                                  +   # adipose return
                a_Fs  * Fskin * ((A_skin/V_skin)/Pskinb)                       +   # skin (fraction a_Fs → blood)
                Fbrain* ((A_brain/V_brain)/Pbb)                                +   # brain return
                (Fliv+Fgon+Fgit+Frp) * ((A_liv/V_liv)/Plivb)                  +   # liver/gonad/GIT/RP return
                (Fkidney+(1-a_Fs)*Fskin+(1-a_Fpp)*Fpp)*((A_kidney/V_kidney)/Pkidb) + # kidney-routed return
                a_Fpp * Fpp * ((A_pp/V_pp)/Pppb))                             +   # PP fraction → blood
      Flux_reab_GIT - Ab_abL - Ffil*free*(A_blood/V_blood)
    # Note: a_Fs = fraction of skin venous return going to blood (vs kidney)
    #       a_Fpp = fraction of PP venous return going to blood (vs kidney)
 
    # --- Liver mass balance ---
    # Inflow:  arterial blood + venous returns from gonad, RP, GIT (portal vein) + transporters (ntcp, oatp2b1)
    # Outflow: venous return + biliary excretion (p-gp, mrp2) + bile flow to GB
    dA_liv = free * (Fliv*(A_blood/V_blood) +
                     Fgon *((A_gon/V_gon)/Pgonb)  +   # gonad venous → liver
                     Frp  *((A_rp/V_rp)/Prpb)     +   # RP venous → liver
                     Fgit *((A_git/V_git)/Pgitb))  -   # GIT portal → liver
      free * (Fliv+Frp+Fgit+Fgon) * ((A_liv/V_liv)/Plivb) +   # hepatic venous outflow
      Ab_abL - Flux_excr_Liv - Flux_bile_Liv                    # transporter net
 
    # --- Gallbladder mass balance ---
    # Inflow:  biliary secretion (passive + transporter-mediated) from liver
    # Outflow: bile flow to GI tract (F_bile × concentration)
    dA_GB  = Flux_bile_Liv + Flux_excr_Liv - F_bile*(A_GB/V_GB)
 
    # --- GI tract mass balance ---
    # Inflow:  arterial blood + bile from GB (fraction 1-R_loss after fecal loss)
    # Outflow: venous return to liver + OSTα intestinal reabsorption
    dA_git = free*Fgit*((A_blood/V_blood) - (A_git/V_git)/Pgitb) +
      (1 - R_loss) * F_bile * (A_GB/V_GB) - Flux_reab_GIT
 
    # --- Kidney mass balance ---
    # Inflow:  arterial blood + routed venous from PP and skin + renal reabsorption from filtrate
    # Outflow: venous return (via Pkidb)
    dA_kidney = free * (Fkidney*(A_blood/V_blood) +
                        (1-a_Fpp)*Fpp*((A_pp/V_pp)/Pppb)   +   # PP fraction → kidney
                        (1-a_Fs)*Fskin*((A_skin/V_skin)/Pskinb)) -   # skin fraction → kidney
      free * (Fkidney+(1-a_Fpp)*Fpp+(1-a_Fs)*Fskin) *
      ((A_kidney/V_kidney)/Pkidb) + Re_abk   # reabsorption adds back to kidney tissue
 
    # --- Glomerular filtrate mass balance ---
    # Inflow:  filtration from blood at glomerulus
    # Outflow: reabsorption (oct + oatp2b1K) + urinary excretion
    dA_fil   = Ffil*free*(A_blood/V_blood) - Re_abk - dA_urine
 
    # --- Exposure water mass balance ---
    # Outflow: gill absorption (fish takes up PFAS)
    # Inflow:  gill excretion (back-diffusion) + urine + feces re-enter water
    dA_water = dA_excr_water_flux - dA_absorb_gill
 
    # ==================================================================
    # 15. Diagnostic outputs (not state variables — for verification)
    # ==================================================================
    # Mass balance check: absorbed - body burden - total excreted should ≈ 0
    A_body    = A_blood+A_liv+A_GB+A_gon+A_brain+A_fat+
                A_skin+A_kidney+A_fil+A_git+A_pp+A_rp
    Mass_bal  = A_absorb_gill - A_body - A_excr_water   # should be ≈ 0 at all times
 
    # Tissue concentrations (microg/mL or microg/g wet weight)
    C_whole_body = A_body / BW
    C_blood   = A_blood  / V_blood
    C_plasma  = A_blood  / V_blood * (1-free) / 0.55   # plasma (hematocrit ~0.45)
    C_liv     = A_liv    / V_liv
    C_fat     = A_fat    / V_fat
    C_gon     = A_gon    / V_gon
    C_git     = A_git    / V_git
    C_brain   = A_brain  / V_brain
    C_kidney  = A_kidney / V_kidney
    C_fil     = A_fil    / V_fil
    C_skin    = A_skin   / V_skin
    C_rp      = A_rp     / V_rp
    C_pp      = A_pp     / V_pp
    # Carcass = remaining tissues (blood, liver, gonad, GB, brain excluded)
    C_carcass = (A_body-A_blood-A_gon-A_liv-A_GB-A_brain) /
                (V_total-V_blood-V_gon-V_liv-V_GB-V_brain)
 
    list(c(dV_urine,
           dA_absorb_gill, dA_excr_gill, dA_urine, dA_feces,
           dA_excr_water_flux, dA_GB, dA_blood, dA_liv, dA_gon,
           dA_fat, dA_git, dA_brain, dA_kidney, dA_fil,
           dA_skin, dA_rp, dA_pp, dA_water),
         "Mass_balance" = Mass_bal,     # should remain ≈ 0 (verification)
         "P_avail"      = P_avail * 1e6,  # remaining free protein (nmol/L)
         "free"         = free,          # unbound fraction in blood (0–1)
         "C_whole_body" = C_whole_body,  # microg/g fish
         "C_blood"      = C_blood,       # microg/mL blood
         "C_liv"        = C_liv,         # microg/mL liver
         "C_gon"        = C_gon,
         "C_git"        = C_git,
         "C_brain"      = C_brain,
         "C_kidney"     = C_kidney,
         "C_fil"        = C_fil,
         "C_carcass"    = C_carcass,
         "C_plasma"     = C_plasma)
  })
}
 
# =============================================================================
# SECTION II: PARAMETER DEFINITIONS
# ============================================================================= 
phys_parms <- c(
  # Body weight references for allometric scaling
  Bw_Fcard_ref = 0.5,     # reference BW for cardiac output scaling (g)
  BW_VO2_ref   = 0.4,     # reference BW for oxygen consumption scaling (g)
 
  # Arrhenius parameters for temperature correction [REF: Erickson & McKim 1990]
  TA         = 3000,       # Arrhenius temperature constant (K)
  TR_Fcard   = 299.5,      # reference temperature for Fcard (K, ≈ 26.35°C)
  TR_VO2     = 300.15,     # reference temperature for VO2 (K, ≈ 27°C)
 
  # Exposure system [user-defined — see Exposure section below]
  V_water    = 1E12,       # volume of exposure water (mL); set large = constant exposure
 
  # Reference cardiac output and oxygen consumption
  F_card_ref = 41.328,     # cardiac output at ref conditions (mL/d/g BW)
  VO2_ref    = 9.84,       # O2 consumption at ref conditions (mL O2/d/g BW)
  OEE        = 0.71,       # oxygen extraction efficiency at gills (unitless) [REF]
  Sat        = 0.90,       # O2 saturation of exposure water (fraction) [user-defined]
  art_ven_frac = 1/3,      # arterial:venous concentration ratio [REF]
 
  # Allometric scaling coefficients for tissue volumes: V = sc * BW^0.75
  sc_blood  = 0.0222,  # blood volume scaling coeff (mL/g^0.75)
  sc_gon    = 0.05,    # gonad
  sc_brain  = 0.01,    # brain
  sc_liv    = 0.02,    # liver
  sc_GB     = 0.0008,  # gallbladder
  sc_fat    = 0.022,   # adipose
  sc_skin   = 0.10,    # skin
  sc_git    = 0.051,   # GI tract
  sc_kidney = 0.002,   # kidney
  sc_fil    = 0.0002,  # glomerular filtrate compartment
  sc_rp     = 0.0266,  # richly perfused (heart, spleen, etc.)
 
  # Fractional blood flow to each tissue (fraction of cardiac output)
  gon_frac    = 0.01252,
  brain_frac  = 0.0324,
  liv_frac    = 0.01942,
  fat_frac    = 0.0135,
  skin_frac   = 0.05639,
  git_frac    = 0.174,
  kidney_frac = 0.01,
  fil_frac    = 0.005,    # fraction of cardiac output filtered at glomerulus
  rp_frac     = 0.13255,
  # Note: Fpp = Fcard - sum(all others) to ensure mass balance
 
  # Venous routing fractions [REF / assumed]
  a_Fpp = 0.4,   # fraction of poorly perfused venous blood routed to blood (vs kidney)
  a_Fs  = 0.1,   # fraction of skin venous blood routed to blood (vs kidney)
 
  # Protein binding 
  P_avail = 0.0008,  # total plasma protein binding capacity (mol/L,Golosovskaia et al. 2024)
 
  # Chemical ionization and partition correction [REF]
  delta_Kow = 3.1,   # log10 decrease in Kow for ionized vs neutral form (acid PFAS)
 
  # Urine production rate
  urine_rate = 0.073,  # mL urine/d/g^0.75 BW
 
  # Transporter reference scaling factors (relative expression, unitless)
  # These correct for difference in transporter abundance between zebrafish and reference system
  nctp_REF    = 1.01,  # ntcp (hepatic uptake)
  oatp2b1_REF = 1.88,  # oatp2b1 (hepatic + renal uptake)
  oct_REF     = 1.09,  # oct (renal reabsorption)
  p_gp_REF    = 1.69,  # p-gp/ABCB1 (hepatic efflux)
  mrp_REF     = 0.58,  # mrp2/ABCC2 (hepatic efflux)
  osta_REF    = 3.09   # OSTα (intestinal efflux/reabsorption)
)
 
# Chemical-specific parameters (n=4 compounds: PFOS, PFHxS, PFOA, PFBS)
# Defined as a NAMED LIST so every element is accessed by name (e.g. chem_parms$WaterExposure),
# not by positional index. This means adding, removing, or reordering parameters
# in this block will never silently break downstream code.
# Each element is a numeric vector of length n; order: [PFOS, PFHxS, PFOA, PFBS]
chem_parms <- list(
  # --- Physicochemical properties ---
  i       = c(1, 1, 1, 1),          # ionization class: 1 = acid (all PFAS here are acids)
  pKa     = c(-3.27, -3.34,  0.5, -3.57),  # acid pKa (negative = strong acid)
  logKow  = c( 6.05,  5.05,  5.0,   3.9),  # log octanol-water partition coeff (neutral form)
  MW      = c(500.13, 400.12, 414.07, 300.1),  # molecular weight (g/mol)
 
  # --- Plasma protein binding ---
  pKd     = c(4.10,   3.15,  3.08,  2.98),  # log Ka for albumin binding (M^-1)
 
  # --- Tissue:blood partition coefficients  ---
  Plivb   = c(1.78,   1.75,  1.74,  1.71),  # liver:blood
  Pgonb   = c(0.55,   0.32,  0.40,  0.19),  # gonad:blood
  Pbb     = c(0.13,   0.06,  0.50,  0.12),  # brain:blood
  Prpb    = c(0.35,   0.13,  0.26,  0.27),  # richly perfused:blood
  Pppb    = c(0.13,   0.06,  0.05,  0.20),  # poorly perfused:blood
  Pgitb   = c(1.93,   1.90,  1.90,  1.85),  # GI tract:blood
  Pfatb   = c(0.6,    0.5,   0.5,   0.4),   # adipose:blood
  Pskinb  = c(0.6,    0.5,   0.5,   0.4),   # skin:blood
  Pkidb   = c(0.35,   0.64,  0.64,  0.7),   # kidney:blood
 
  # --- Hepatic transporter kinetics ---
  Vmax_ntcp    = c(1483.37, 961.40, 367.11, 132.04),  # ntcp Vmax (nmol/d/g^0.75)
  Km_ntcp      = c( 155.02, 117.81, 189.26,  22.87),  # ntcp Km (nmol/mL = μM)
  Vmax_oatp2b1 = c( 697.98, 230.47, 183.29,  51.86),  # oatp2b1 hepatic Vmax
  Km_oatp2b1   = c(  23.81,  21.25,  59.49,  36.61),  # oatp2b1 hepatic Km
 
  # --- Hepatic efflux transporter clearances ---
  CL_excrL_p_gp_BW = c(  5.44,   2.57,   3.43,   0.0),  # p-gp CL (mL/d/g^0.75)
  CL_excrL_mrp_BW  = c(  6.21,   4.06,   3.42,   0.0),  # mrp CL (mL/d/g^0.75)
 
  # --- Intestinal efflux  ---
  CL_excrG_osta_BW = c( 5.43,   1.21,   2.17,   0.12),  # osta CL (mL/d)
 
  # --- Renal transporter kinetics ---
  Vmax_oatp2b1K = c( 48.40,  19.36,  14.95,   2.90),  # oatp2b1 renal Vmax
  Km_oatp2b1K   = c( 23.81,  21.25,  59.49,  36.61),  # oatp2b1 renal Km
  CL_ReabK_oct_BW = c( 0.16,  0.23,  0.49,   0.0), # oct renal reabsorption CL
 
  # --- Fecal elimination fraction [REF / assumed] ---
  R_loss = c(0.028, 0.028, 0.028, 0.028),  # fraction of biliary PFAS lost in feces (rest reabsorbed)
 
  # --- Protein binding state (initialized; updated iteratively in ODE) ---
  PL          = c(0, 0, 0, 0),  # protein-bound amount (mol/L); initialized to 0
  blood_bound = c(0, 0, 0, 0),  # bound mass in blood (microg); initialized to 0
 
  # --- Water exposure concentrations (microg/mL = ng/L*10^-3) [user-defined] ---
  # Uncomment the appropriate dataset for each validation scenario:
  #WaterExposure = c(0.001, 11.4, 8.9, 8.7) * 1e-3        # Golosovskaia et al.
  #WaterExposure = c(10.10, 0.01, 10.6, 8.9) * 1e-3       # Wen et al.
  #WaterExposure = c(1.12, 1.09, 0.86, 2.15) * 1e-3       # Chen et al. — low dose
  #WaterExposure = c(10.2, 15.2, 6.64, 10.8) * 1e-3       # Chen et al. — high dose
  WaterExposure  = c(50.0, 50.0, 50.0, 50.0) * 1e-3       # [ACTIVE] uniform 50 ng/mL scenario
)
 
# =============================================================================
# SECTION III: INITIAL CONDITIONS AND SIMULATION SETUP
# =============================================================================
n <- 4  # number of chemicals simulated simultaneously (PFOS, PFHxS, PFOA, PFBS)
 
# ------------------------------------------------------------------
# Step 1: Define exposure conditions and merge with physiological params
# MUST come first — yini and events both depend on these values
# ------------------------------------------------------------------
exposure_parms <- c(
  TC_c              = 26,  # water temperature (°C)
  BW                = 0.8, # fish body weight (g)
  time_first_dose   = 0,   # start of waterborne exposure (d)
  time_end_exposure = 28   # end of waterborne exposure (d); clean water thereafter
)
 
# phys_exp_parms: merged parameter vector passed to ODE solver
phys_exp_parms <- c(phys_parms, exposure_parms, n = n)
 
# Simulation time vector (days): exposure (0–28 d) + depuration (28–48 d)
Times <- seq(0, 48)
 
# ------------------------------------------------------------------
# Step 2: Set initial state vector
# All compartment amounts = 0 except A_water (loaded from exposure)
# A_water = WaterExposure (microg/mL) × V_water (mL) = total mass in vessel
# ------------------------------------------------------------------
yini <- c(
  V_urine       = 0,
  A_absorb_gill = rep(0, n),  # cumulative gill uptake
  A_excr_gill   = rep(0, n),  # cumulative gill excretion
  A_urine       = rep(0, n),  # cumulative urinary excretion
  A_feces       = rep(0, n),  # cumulative fecal excretion
  A_excr_water  = rep(0, n),  # cumulative total excretion (all routes)
  A_GB          = rep(0, n),  # gallbladder
  A_blood       = rep(0, n),  # blood
  A_liv         = rep(0, n),  # liver
  A_gon         = rep(0, n),  # gonads
  A_fat         = rep(0, n),  # adipose
  A_git         = rep(0, n),  # GI tract
  A_brain       = rep(0, n),  # brain
  A_kidney      = rep(0, n),  # kidney
  A_fil         = rep(0, n),  # glomerular filtrate
  A_skin        = rep(0, n),  # skin
  A_rp          = rep(0, n),  # richly perfused
  A_pp          = rep(0, n),  # poorly perfused
  # Initial water mass = concentration (microg/mL) × volume (mL)
  # Accessed by name from the list — robust to any future reordering of chem_parms
  A_water = chem_parms$WaterExposure * phys_parms["V_water"]
)
# ------------------------------------------------------------------
# Step 3: Define exposure cessation event
# phys_exp_parms must already exist here (defined in Step 1 above)
# ------------------------------------------------------------------
water_exp_event <- character(n)
for (ii in seq_len(n)) {
  water_exp_event[ii] <- if (n > 1) paste0("A_water", ii) else "A_water"
}
events <- list(data = data.frame(
  var    = water_exp_event,
  time   = as.numeric(phys_exp_parms["time_end_exposure"]),  # day 28
  value  = 0,        # replace A_water with 0 (depuration begins)  
value = 0， # 将 A_water 替换为 0（清纯开始）
  method = "replace"
))
 
# =============================================================================
# SECTION IV: BASELINE PBTK SIMULATION
# =============================================================================
# Output: out_df — data frame with one row per time point, columns = state variables
#         + all diagnostic outputs (C_blood, C_liv, etc.)
 
out    <- ode(times   = Times,
              func    = ZF.model.c,
              y       = yini,
              parms   = phys_exp_parms,
              chem_parms = chem_parms,
              method  = "lsodes",
              events  = events)
out_df <- as.data.frame(out)
print(out)
